NETWORK_INTERFACE=en0
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./threatscope.db
# Never enable this in cloud staging; it can hide a Supabase outage with local-only data.
ALLOW_DATABASE_FALLBACK=false
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
API_URL=http://localhost:8000/alerts
API_BASE_URL=http://localhost:8000
DEMO_MODE=false
ALERT_COOLDOWN_SECONDS=60
ARP_ENTRY_TTL_SECONDS=300
ARP_SPOOF_CONFIRMATION_THRESHOLD=2
# ALLOWED_SUBNETS=192.168.12.0/24
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_ALERTS_TABLE=alerts
SUPABASE_RUNTIME_STATE_TABLE=runtime_state
SUPABASE_SENSOR_ENROLLMENTS_TABLE=sensor_enrollment_codes
SUPABASE_SENSORS_TABLE=sensors
SUPABASE_SCAN_STATE_TABLE=sensor_scan_state
SUPABASE_JWT_SECRET=
# Set true only for local API smoke tests. Never enable this for a shared demo or deployment.
ALLOW_INSECURE_LOCAL_DEV=false
# Comma-separated dashboard URLs allowed to call the API.
DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Shared only by the engine, API simulator, and manual demo-reset command. Never expose in the dashboard.
ENGINE_API_KEY=
# Demo-only owner for ENGINE_API_KEY traffic. Enrolled sensors use their own account automatically.
SENSOR_OWNER_USER_ID=
# Developer/recovery enrollment only. The graphical installer stores these separately.
SENSOR_ENROLLMENT_CODE=
SENSOR_ID=
SENSOR_TOKEN=
SENSOR_HEARTBEAT_INTERVAL_SECONDS=5
SENSOR_HEARTBEAT_COMMAND_SECONDS=5
SENSOR_HEARTBEAT_TIMEOUT_SECONDS=20
SENSOR_CAPTURE_RETRY_SECONDS=30
SENSOR_ENROLLMENT_TTL_SECONDS=600
SENSOR_MAX_PER_USER=10
MONITORING_DEFAULT_ENABLED=true
# Optional CDN or release-asset override. The dashboard otherwise serves its bundled project installer.
VITE_SENSOR_INSTALLER_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_ALERT_LIMIT=20
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3.6-27b
SCAN_WINDOW_SECONDS=8
SCAN_SCHEDULER_POLL_SECONDS=5
SCAN_INTERVAL_MINUTES=5
