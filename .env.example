NETWORK_INTERFACE=en0
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./threatscope.db
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ALERTS_TABLE=alerts

# AI diagnostics: use "ollama" for a local model or "openai" for any
# OpenAI-compatible cloud endpoint, including OpenRouter.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=45
AI_ALERT_LIMIT=20
